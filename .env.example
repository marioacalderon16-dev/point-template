# Copia este archivo a .env y completa los valores. .env nunca se sube (ver .gitignore).

# development muestra errores detallados y CORS abierto; sin APP_ENV se asume production
APP_ENV=development
TIME_ZONE=America/Bogota
LOG_LEVEL=debug

# Base de datos: deja activo UN bloque. Usa el mismo motor en desarrollo y produccion
# (SQLite no esta soportado: las migraciones de Scribe no autoincrementan el id).
# Usuario y contraseña van en DB_USER/DB_PASS, nunca dentro de DB_DSN.

# --- Supabase (Postgres) ---
# Supavisor modo sesion (puerto 5432, no el pooler de transaccion 6543)
# Dashboard: Project Settings > Database > Connection string > Session pooler
DB_DSN="pgsql:host=aws-0-us-east-1.pooler.supabase.com;port=5432;dbname=postgres"
DB_USER="postgres.your-project-ref"
DB_PASS="your-db-password"

# --- Neon (Postgres) ---
# Dashboard: Connect > Connection string. De postgresql://USUARIO:CLAVE@HOST/BASE?... toma
# HOST de la URL directa (sin "-pooler") para migraciones y desarrollo. En produccion puedes
# usar el host "-pooler" (PgBouncer en modo transaccion) junto con DB_EMULATE_PREPARES=true.
# DB_DSN="pgsql:host=ep-xxx.region.aws.neon.tech;port=5432;dbname=neondb;sslmode=require"
# DB_USER="neondb_owner"
# DB_PASS="npg_xxx"

# --- Base de tests (php point test) ---
# Crea .env.testing (no se sube a git) con DB_DSN/DB_USER/DB_PASS de una base solo para tests:
# tiene prioridad sobre este archivo y point test la migra antes de ejecutar los tests.
# Sin él, los tests escriben en la base de desarrollo (point test lo avisa).
# Ej. Postgres local: DB_DSN="pgsql:host=127.0.0.1;port=5432;dbname=mi_api_test"

# --- MySQL / MariaDB ---
# DB_DSN="mysql:host=127.0.0.1;port=3306;dbname=mi_api;charset=utf8mb4"
# DB_USER="root"
# DB_PASS="secret"

# Project Settings > API
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="your-anon-key"
SUPABASE_SERVICE_KEY="your-service-role-key"

# Firma de tokens propios del backend (no confundir con el JWT secret de Supabase Auth)
JWT_SECRET="change-me"
JWT_TTL=3600
# Emisor y destinatario de los tokens: verify() rechaza los que no coincidan (por defecto point / point-api)
# JWT_ISSUER=mi-api
# JWT_AUDIENCE=mi-api-clientes

# Jobs: true = ejecutar en linea sin worker (solo desarrollo)
QUEUE_SYNC=true

# Opcionales (ver defaults en core/)
# APP_STRICT_MODE=false
# CORS_ORIGINS=*
# DB_EMULATE_PREPARES=false
# RATE_LIMIT_DIR=storage/ratelimit
# RATE_LIMIT_MAX_FILES=256
# TRUSTED_PROXIES=
# DEPLOY_KEY=   (deploy.php: mínimo 32 caracteres; se envía por POST en la cabecera X-Deploy-Key)
