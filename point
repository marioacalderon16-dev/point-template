/** Directorio del framework desde donde se copian los plugins. */
function frameworkPath(): ?string
{
    if (file_exists('.point.json')) {
        $meta = json_decode(file_get_contents('.point.json'), true);
        $path = $meta['framework'] ?? null;
        if ($path && is_dir("$path/plugins")) {
            return rtrim($path, '/');
        }
    }

    // Ejecutando dentro del propio framework
    if (is_dir(__DIR__ . '/plugins')) {
        return __DIR__;
    }

    return null;
}

function studlyCase(string $value): string
{
    return str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $value)));
}

/** Lee la metadata de un plugin desde cualquier directorio, este instalado o no. */
function pluginMeta(string $dir, string $slug): ?\Core\Plugin
{
    if (!is_file("$dir/plugin.php")) {
        return null;
    }

    $class = require "$dir/plugin.php";

    if (!is_string($class)) {
        return null;
    }

    if (!class_exists($class, false)) {
        $file = "$dir/src/" . studlyCase($slug) . 'Plugin.php';
        if (is_file($file)) {
            require_once $file;
        }
    }

    return class_exists($class) ? new $class($slug, $dir) : null;
}

/** Slugs presentes en un directorio de plugins. */
function pluginsIn(?string $base): array
{
    if (!$base || !is_dir("$base/plugins")) {
        return [];
    }

    $found = [];
    foreach (scandir("$base/plugins") ?: [] as $entry) {
        if (str_starts_with($entry, '.')) continue;
        if (is_file("$base/plugins/$entry/plugin.php")) {
            $found[] = $entry;
        }
    }
    sort($found);
    return $found;
}

function pluginsConfigTemplate(): string
{
    return "<?php\n\n"
        . "/**\n"
        . " * Plugins habilitados. Comenta una linea para desactivar sin borrar archivos.\n"
        . " *\n"
        . " *   php point plugin:list        ver instalados y disponibles\n"
        . " *   php point plugin:add <slug>  instalar y habilitar\n"
        . " */\n"
        . "return [\n];\n";
}

/** Agrega o quita un slug de config/plugins.php conservando el resto del archivo. */
function togglePluginConfig(string $slug, bool $enable): void
{
    $file = 'config/plugins.php';

    if (!file_exists($file)) {
        if (!is_dir('config')) mkdir('config', 0755, true);
        file_put_contents($file, pluginsConfigTemplate());
    }

    $content = file_get_contents($file);
    $listed = preg_match("/^\s*'" . preg_quote($slug, '/') . "'\s*,?\s*$/m", $content) === 1;

    if ($enable && !$listed) {
        $content = preg_replace('/\n\];\s*$/', "\n    '$slug',\n];\n", $content, 1);
    } elseif (!$enable && $listed) {
        $content = preg_replace("/^\s*'" . preg_quote($slug, '/') . "'\s*,?\s*\n/m", '', $content, 1);
    }

    file_put_contents($file, $content);
}

function listPlugins(): void
{
    requireProject();

    $active = \Core\PluginManager::all();
    $installed = \Core\PluginManager::available();
    $source = frameworkPath();
    $catalog = ($source && realpath($source) !== realpath(getcwd())) ? pluginsIn($source) : [];

    $all = array_values(array_unique(array_merge($installed, $catalog)));
    sort($all);

    if (empty($all)) {
        echo "No hay plugins instalados ni disponibles.\n";
        return;
    }

    $width = max(array_map('strlen', $all)) + 2;

    echo "\n  " . str_pad('PLUGIN', $width) . str_pad('ESTADO', 22) . "DESCRIPCION\n";
    echo '  ' . str_repeat('─', $width + 22 + 45) . "\n";

    foreach ($all as $slug) {
        if (isset($active[$slug])) {
            $estado = "\033[32mactivo\033[0m";
            $pad = 22 - 6;
            $desc = $active[$slug]->description();
        } elseif (in_array($slug, $installed, true)) {
            $estado = "\033[33minstalado\033[0m";
            $pad = 22 - 9;
            $meta = pluginMeta(getcwd() . "/plugins/$slug", $slug);
            $desc = $meta ? $meta->description() : '';
        } else {
            $estado = "\033[90mdisponible\033[0m";
            $pad = 22 - 10;
            $meta = pluginMeta("$source/plugins/$slug", $slug);
            $desc = $meta ? $meta->description() : '';
        }

        echo '  ' . str_pad($slug, $width) . $estado . str_repeat(' ', $pad) . $desc . "\n";
    }

    echo "\n  \033[32mactivo\033[0m = instalado y habilitado";
    echo "   \033[33minstalado\033[0m = falta habilitarlo en config/plugins.php";
    echo "   \033[90mdisponible\033[0m = php point plugin:add <slug>\n\n";
}

function addPlugin(?string $slug): void
{
    if (!$slug) {
        echo "Uso: php point plugin:add <slug>\n";
        echo "Ver disponibles: php point plugin:list\n";
        exit(1);
    }

    if (!file_exists('vendor/autoload.php')) {
        echo "Error: Ejecuta 'composer install' primero.\n";
        exit(1);
    }
    require_once 'vendor/autoload.php';

    $source = frameworkPath();

    if (!$source) {
        echo "No se encontro el framework de origen.\n";
        echo "Crea .point.json con: {\"framework\": \"/ruta/al/framework\"}\n";
        exit(1);
    }

    if (realpath($source) === realpath(getcwd())) {
        echo "Estas dentro del framework: sus plugins ya viven en plugins/.\n";
        echo "Habilitalos en config/plugins.php o usa plugin:list.\n";
        exit(1);
    }

    $installed = installPluginTree($slug, $source, []);

    if (empty($installed)) {
        exit(1);
    }

    echo "\nHabilitado en config/plugins.php: " . implode(', ', $installed) . "\n";
    echo "Verifica con: php point plugin:list\n";
}

/** Copia el plugin y sus dependencias. Devuelve los slugs instalados. */
function installPluginTree(string $slug, string $source, array $seen): array
{
    if (in_array($slug, $seen, true)) {
        return [];
    }
    $seen[] = $slug;

    $from = "$source/plugins/$slug";

    if (!is_file("$from/plugin.php")) {
        echo "El plugin '$slug' no existe en $source/plugins/\n";
        echo 'Disponibles: ' . implode(', ', pluginsIn($source)) . "\n";
        return [];
    }

    $done = [];
    $meta = pluginMeta($from, $slug);

    foreach ($meta ? $meta->requires() : [] as $dep) {
        $done = array_merge($done, installPluginTree($dep, $source, $seen));
    }

    $to = "plugins/$slug";

    if (is_dir($to)) {
        echo "  ya instalado: $slug\n";
    } else {
        copyTree($from, $to);
        echo "  instalado: $slug" . ($meta && $meta->description() ? ' — ' . $meta->description() : '') . "\n";
    }

    togglePluginConfig($slug, true);
    reportPluginExtras($to, $slug);

    return array_merge($done, [$slug]);
}

/** Avisa de migraciones o variables de entorno que trae el plugin. */
function reportPluginExtras(string $dir, string $slug): void
{
    foreach (glob("$dir/database/*.sql") ?: [] as $sql) {
        echo "      migracion pendiente: $sql\n";
    }

    if (is_dir("$dir/endpoints")) {
        $count = count(glob("$dir/endpoints/*.php") ?: []);
        if ($count > 0) {
            echo "      aporta $count endpoint(s) — revisalos con: php point routes\n";
        }
    }

    if (is_file("$dir/.env.example")) {
        echo "      variables de entorno sugeridas en $dir/.env.example\n";
    }
}

function removePlugin(array $args): void
{
    $slug = $args[0] ?? null;
    $purge = in_array('--purge', $args, true);

    if (!$slug) {
        echo "Uso: php point plugin:remove <slug> [--purge]\n";
        echo "  --purge  ademas de deshabilitarlo, borra plugins/<slug>/\n";
        exit(1);
    }

    if (!is_dir("plugins/$slug")) {
        echo "El plugin '$slug' no esta instalado.\n";
        exit(1);
    }

    if (file_exists('vendor/autoload.php')) {
        require_once 'vendor/autoload.php';
    }

    // Solo bloquea si un plugin HABILITADO depende de este; si el dependiente
    // esta instalado pero deshabilitado, basta con avisar.
    $enabled = enabledPlugins();
    $dormant = [];

    foreach (pluginsIn(getcwd()) as $other) {
        if ($other === $slug) continue;

        $meta = pluginMeta(getcwd() . "/plugins/$other", $other);
        if (!$meta || !in_array($slug, $meta->requires(), true)) {
            continue;
        }

        if (in_array($other, $enabled, true)) {
            echo "No se puede quitar: el plugin '$other' esta habilitado y depende de '$slug'.\n";
            echo "Quita primero '$other'.\n";
            exit(1);
        }

        $dormant[] = $other;
    }

    togglePluginConfig($slug, false);
    echo "Deshabilitado en config/plugins.php: $slug\n";

    if ($purge) {
        removeTree("plugins/$slug");
        echo "Eliminado: plugins/$slug\n";
    } else {
        echo "Los archivos siguen en plugins/$slug (usa --purge para borrarlos).\n";
    }

    foreach ($dormant as $other) {
        echo "Aviso: '$other' esta instalado (deshabilitado) y depende de '$slug'.\n";
    }
}

/** Slugs habilitados en config/plugins.php. */
function enabledPlugins(): array
{
    if (!file_exists('config/plugins.php')) {
        return [];
    }

    $list = require 'config/plugins.php';

    return is_array($list) ? array_values(array_filter($list, 'is_string')) : [];
}

function removeTree(string $dir): void
{
    foreach (scandir($dir) ?: [] as $entry) {
        if ($entry === '.' || $entry === '..') continue;
        $path = "$dir/$entry";
        is_dir($path) ? removeTree($path) : unlink($path);
    }
    rmdir($dir);
}

function createPlugin(?string $name): void
{
    if (!$name) {
        echo "Uso: php point make:plugin nombre-del-plugin\n";
        exit(1);
    }

    $slug = strtolower(preg_replace('/[^a-zA-Z0-9\-_]/', '', $name));
    $studly = str_replace(' ', '', ucwords(str_replace(['-', '_'], ' ', $slug)));
    $dir = "plugins/$slug";

    if (is_dir($dir)) {
        echo "Ya existe: $dir\n";
        exit(1);
    }

    mkdir("$dir/src", 0755, true);

    file_put_contents("$dir/plugin.php", "<?php\n\nreturn \\Plugins\\{$studly}\\{$studly}Plugin::class;\n");

    $class = <<<PHP
<?php
namespace Plugins\\{$studly};

use Core\Plugin;

final class {$studly}Plugin extends Plugin
{
    public function description(): string
    {
        return '';
    }

    /** Otros plugins que deben cargarse antes que este. */
    public function requires(): array
    {
        return [];
    }

    /** Alias de compatibilidad: 'Core\NombreViejo' => NuevaClase::class */
    public function aliases(): array
    {
        return [];
    }

    /** Bindings, middlewares y listeners. Corre antes de la config de la app. */
    public function register(): void
    {
    }

    /** Configuracion que depende de env u otros plugins. Corre al final del arranque. */
    public function boot(): void
    {
    }
}
PHP;

    file_put_contents("$dir/src/{$studly}Plugin.php", "$class\n");

    echo "Plugin creado: $dir\n\n";
    echo "  $dir/plugin.php              devuelve la clase del plugin\n";
    echo "  $dir/src/{$studly}Plugin.php\n";
    echo "  $dir/src/                    autocargado como Plugins\\{$studly}\\...\n";
    echo "  $dir/helpers.php             (opcional) funciones globales\n";
    echo "  $dir/endpoints/              (opcional) endpoints propios\n\n";
    echo "Agrega '$slug' a config/plugins.php para habilitarlo.\n";
}

