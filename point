/**
 * php point logs [--level=info] [--grep=texto] [--lines=50] [--date=AAAA-MM-DD] [--follow|-f] [--no-color]
 * Muestra storage/logs con colores por nivel. --level es el nivel mínimo; --follow sigue el
 * archivo en vivo (cambia de archivo al pasar la medianoche). Ctrl+C para salir.
 */
function showLogs(array $args): void
{
    $levels = ['debug' => 0, 'info' => 1, 'warning' => 2, 'error' => 3];
    $opts = ['level' => 'debug', 'grep' => null, 'lines' => 50, 'date' => null, 'follow' => false, 'color' => stream_isatty(STDOUT)];
    foreach ($args as $arg) {
        if ($arg === '--follow' || $arg === '-f') {
            $opts['follow'] = true;
        } elseif ($arg === '--no-color') {
            $opts['color'] = false;
        } elseif (preg_match('/^--(level|grep|lines|date)=(.+)$/', $arg, $m)) {
            $opts[$m[1]] = $m[2];
        } else {
            echo "Opción desconocida: $arg\n";
            exit(1);
        }
    }
    $opts['level'] = strtolower((string) $opts['level']);
    if (!isset($levels[$opts['level']])) {
        echo "Nivel no válido: {$opts['level']} (debug, info, warning, error)\n";
        exit(1);
    }
    if ($opts['date'] !== null && !preg_match('/^\d{4}-\d{2}-\d{2}$/', (string) $opts['date'])) {
        echo "Fecha no válida: {$opts['date']} (AAAA-MM-DD)\n";
        exit(1);
    }

    $dir = getcwd() . '/storage/logs';
    $min = $levels[$opts['level']];
    $colors = ['ERROR' => "\033[31m", 'WARNING' => "\033[33m", 'INFO' => "\033[32m", 'DEBUG' => "\033[90m"];

    $format = function (string $line) use ($levels, $min, $opts, $colors): ?string {
        if (!preg_match('/^\[([^\]]+)\] ([A-Z]+): (.*)$/', $line, $m)) {
            return null;
        }
        if (($levels[strtolower($m[2])] ?? 0) < $min) {
            return null;
        }
        if ($opts['grep'] !== null && stripos($line, (string) $opts['grep']) === false) {
            return null;
        }
        if (!$opts['color']) {
            return $line;
        }
        $c = $colors[$m[2]] ?? '';
        return "\033[90m[{$m[1]}]\033[0m {$c}" . str_pad($m[2], 7) . "\033[0m {$m[3]}";
    };

    $file = fn () => $dir . '/' . ($opts['date'] ?? date('Y-m-d')) . '.log';
    $current = $file();
    if (!is_file($current) && !$opts['follow']) {
        echo "No hay log en " . basename($current) . " (storage/logs).\n";
        return;
    }

    $lines = is_file($current) ? (file($current, FILE_IGNORE_NEW_LINES) ?: []) : [];
    $shown = array_values(array_filter(array_map($format, $lines), fn ($l) => $l !== null));
    foreach (array_slice($shown, -max(1, (int) $opts['lines'])) as $l) {
        echo $l, "\n";
    }
    if (!$opts['follow']) {
        return;
    }

    $offset = is_file($current) ? (int) filesize($current) : 0;
    while (true) { // @phpstan-ignore while.alwaysTrue
        usleep(500000);
        if ($opts['date'] === null && $file() !== $current) {
            $current = $file(); // medianoche: archivo nuevo
            $offset = 0;
        }
        clearstatcache(true, $current);
        $size = is_file($current) ? (int) filesize($current) : 0;
        if ($size < $offset) {
            $offset = 0; // truncado o rotado
        }
        if ($size > $offset) {
            $h = fopen($current, 'r');
            fseek($h, $offset);
            while (($line = fgets($h)) !== false) {
                $out = $format(rtrim($line, "\n"));
                if ($out !== null) {
                    echo $out, "\n";
                }
            }
            $offset = (int) ftell($h);
            fclose($h);
        }
    }
}

/**
 * Prueba de humo: llama a todas las rutas con datos de ejemplo (sampleRequest) y falla si alguna
 * responde 5xx. Por defecto solo GET; --smoke=all incluye POST/PUT/PATCH/DELETE, que ESCRIBEN en
 * la base (usar con .env.testing). Las rutas protegidas reciben un token con el rol que piden.
 */
function runSmoke(bool $all): never
{
    define('POINT_NO_MANIFEST', true);
    require_once 'bootstrap.php';

    $routes = \Core\RouteRegistry::getInstance()->getRoutes();
    usort($routes, fn ($a, $b) => strcmp($a['path'], $b['path']));

    $rows = [];
    $failed = 0;
    $skipped = 0;
    foreach ($routes as $route) {
        $access = routeAccess($route);
        foreach ($route['methods'] as $method) {
            if (!$all && $method !== 'GET') {
                $skipped++;
                continue;
            }
            ['path' => $path, 'fields' => $fields] = sampleRequest($route, $method);
            $headers = [];
            if ($access['protected']) {
                $role = str_starts_with($access['label'], 'roles: ') ? explode(',', substr($access['label'], 7))[0] : null;
                $headers['Authorization'] = 'Bearer ' . \Core\Auth::issue(array_filter(['sub' => 1, 'role' => $role]));
            }
            $status = http($method, $path, $fields, $headers)->status;
            $ok = $status < 500;
            $failed += $ok ? 0 : 1;
            $rows[] = sprintf("  %s  %-7s %-40s %d", $ok ? "\033[32mOK\033[0m  " : "\033[31mFAIL\033[0m", $method, $route['path'], $status);
        }
    }

    echo "\n  Prueba de humo (" . ($all ? 'todos los métodos' : 'solo GET; --smoke=all incluye escrituras') . ")\n\n";
    echo implode("\n", $rows) . "\n\n";
    printf("  %d rutas probadas, %s%s\n", count($rows),
        $failed ? "\033[31m$failed con error 5xx\033[0m" : "\033[32msin errores 5xx\033[0m",
        $skipped ? ", $skipped de escritura omitidas" : '');
    \Core\TestRunner::stopServer();
    exit($failed ? 1 : 0);
}

function runTests(?string $filter = null): void
{
    if (!file_exists('vendor/autoload.php')) {
        echo "Error: Ejecuta 'composer install' primero.\n";
        exit(1);
    }

    require_once 'vendor/autoload.php';
    require_once __DIR__ . '/core/Testing.php';

    $testsDir = getcwd() . '/tests';

    if (!is_dir($testsDir)) {
        echo "No existe el directorio tests/\n";
        exit(1);
    }

    // --smoke prueba las rutas reales de la app: sin las rutas de fixtures de tests/
    $smoke = str_starts_with((string) $filter, '--smoke');
    // El servidor de test hereda esta variable y carga tests/fixtures/endpoints
    if (!$smoke) {
        putenv('POINT_TESTING=1');
    }
    // Contadores de rate limit aislados por ejecución (no arrastra intentos de corridas previas)
    putenv('RATE_LIMIT_DIR=' . sys_get_temp_dir() . '/point-ratelimit-' . getmypid());

    // Mismo entorno que el servidor de test (proceso primero, luego .env): así Auth::issue() en
    // un test firma con el JWT_SECRET que verifica el servidor. Sin uno válido, uno por corrida
    $dsnFromProcess = getenv('DB_DSN') !== false;
    foreach (getenv() as $key => $value) {
        $_ENV[$key] ??= $value;
    }
    // .env.testing (opcional, p. ej. DB_DSN de una base solo para tests) va antes que .env; lo que
    // carga se exporta para que el servidor de test y scribe lo hereden. El proceso sigue mandando
    $testingVars = [];
    if (file_exists(getcwd() . '/.env.testing')) {
        $testingVars = Dotenv\Dotenv::createImmutable(getcwd(), '.env.testing')->safeLoad();
        foreach ($testingVars as $key => $value) {
            putenv("$key=$value");
        }
    }
    Dotenv\Dotenv::createImmutable(getcwd())->safeLoad();
    if (file_exists(getcwd() . '/.env.' . ($_ENV['APP_ENV'] ?? 'development'))) {
        Dotenv\Dotenv::createImmutable(getcwd(), '.env.' . ($_ENV['APP_ENV'] ?? 'development'))->safeLoad();
    }
    // Sin APP_ENV la app asume producción; los tests corren como development salvo que se indique
    if (($_ENV['APP_ENV'] ?? '') === '') {
        $_ENV['APP_ENV'] = 'development';
        putenv('APP_ENV=development');
    }
    if (strlen($_ENV['JWT_SECRET'] ?? '') < 32) {
        $_ENV['JWT_SECRET'] = bin2hex(random_bytes(32));
        putenv('JWT_SECRET=' . $_ENV['JWT_SECRET']);
    }

    // Con base propia de tests se migra antes de ejecutarlos (como en CI); sin ella, avisar
    if (isset($testingVars['DB_DSN'])) {
        passthru('php scribe migrate', $code);
        if ($code !== 0) {
            echo "Error: no se pudo migrar la base de tests (.env.testing).\n";
            exit(1);
        }
    } elseif (!$dsnFromProcess && ($_ENV['DB_DSN'] ?? '') !== '') {
        echo "Aviso: los tests usan la base de .env (desarrollo). Crea .env.testing con DB_DSN de una base solo para tests.\n";
    }

    if ($smoke) {
        runSmoke($filter === '--smoke=all');
    }

    $files = \Core\TestRunner::discover($testsDir);

    if (empty($files)) {
        echo "No se encontraron archivos *_test.php o *Test.php en tests/\n";
        exit(0);
    }

    $nameFilter = null;

    if ($filter) {
        $matchedFiles = array_filter($files, fn($f) => stripos($f, $filter) !== false);
        if (!empty($matchedFiles)) {
            $files = array_values($matchedFiles);
        } else {
            $nameFilter = $filter;
        }
    }

    echo "\n  Point Test Runner\n";

    $exitCode = \Core\TestRunner::loadAndRun($files, $nameFilter);
    echo "\n";
    exit($exitCode);
}

