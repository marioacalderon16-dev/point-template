function init(?string $name): void
{
    if (!$name) {
        echo "Uso: php point init nombre-del-proyecto\n";
        exit(1);
    }

    if (is_dir($name)) {
        echo "Error: El directorio '$name' ya existe.\n";
        exit(1);
    }

    $source = __DIR__;

    $dirs = [
        '', 'core', 'core/Middleware', 'core/exceptions', 'core/scribe',
        'endpoints', 'config', 'middlewares', 'services', 'jobs', 'listeners', 'tests',
        'plugins', 'storage', 'storage/jobs', 'storage/jobs/failed',
        'database', 'database/migrations', 'database/seeds',
    ];
    foreach ($dirs as $dir) {
        mkdir("$name/$dir", 0755, true);
    }

    // Git no guarda carpetas vacías: sin .gitkeep, en un clon (CI) faltan rutas de phpstan.neon
    foreach (['middlewares', 'services', 'jobs', 'listeners', 'database/migrations', 'database/seeds'] as $dir) {
        touch("$name/$dir/.gitkeep");
    }

    // Core minimalista: todo lo opcional vive en plugins/
    $coreFiles = [
        'core/Endpoint.php',
        'core/Resource.php',
        'core/Auth.php',
        'core/RouteRegistry.php',
        'core/Connector.php',
        'core/Validator.php',
        'core/InputExtractor.php',
        'core/QueryBuilder.php',
        'core/DB.php',
        'core/Container.php',
        'core/ErrorHandler.php',
        'core/Plugin.php',
        'core/PluginManager.php',
        'core/Log.php',
        'core/Cache.php',
        'core/Event.php',
        'core/Response.php',
        'core/UploadedFile.php',
        'core/helpers.php',
        'core/Testing.php',
        'core/Queue.php',
        'core/Job.php',
        'core/AsyncEndpointJob.php',
        'core/Middleware/MiddlewareManager.php',
        'core/Middleware/AuthMiddleware.php',
        'core/Middleware/CorsMiddleware.php',
        'core/Middleware/SecurityHeadersMiddleware.php',
        'core/Middleware/RateLimitMiddleware.php',
        'core/Middleware/LoggerMiddleware.php',
        'core/exceptions/RouteConfigException.php',
        'core/scribe/Table.php',
        'core/scribe/Runner.php',
        'core/scribe/Seeder.php',
        'core/scribe/SeedRunner.php',
    ];

    foreach ($coreFiles as $file) {
        copy("$source/$file", "$name/$file");
    }

    // Plugins de base: health (GET /health, healthcheck de railway.json) y scheduler
    // (scheduler + config/schedule.php, que el entrypoint de Docker ejecuta cada minuto).
    // El resto se instala a demanda con plugin:add
    $basePlugins = ['health', 'scheduler'];
    foreach ($basePlugins as $slug) {
        copyTree("$source/plugins/$slug", "$name/plugins/$slug");
    }
    file_put_contents("$name/config/plugins.php", str_replace(
        "return [\n];",
        "return [\n" . implode('', array_map(fn ($s) => "    '$s',\n", $basePlugins)) . "];",
        pluginsConfigTemplate()
    ));

    // Origen desde donde plugin:add copiara los plugins
    file_put_contents("$name/.point.json", json_encode([
        'framework' => $source,
    ], JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES) . "\n");

    copy("$source/index.php", "$name/index.php");
    copy("$source/bootstrap.php", "$name/bootstrap.php");
    copy("$source/scribe", "$name/scribe");
    chmod("$name/scribe", 0755);
    copy("$source/deploy.php", "$name/deploy.php");
    copy("$source/.env.example", "$name/.env.example");
    copy("$source/scheduler", "$name/scheduler");
    chmod("$name/scheduler", 0755);
    copy("$source/config/schedule.php", "$name/config/schedule.php");
    copy("$source/endpoints/health.php", "$name/endpoints/health.php");

    // Raíz web (DocumentRoot del Dockerfile); copyTree omite dotfiles como .htaccess
    copyTree("$source/public", "$name/public");
    copy("$source/public/.htaccess", "$name/public/.htaccess");

    // Despliegue (Docker/Railway)
    copy("$source/Dockerfile", "$name/Dockerfile");
    copy("$source/railway.json", "$name/railway.json");
    copy("$source/.dockerignore", "$name/.dockerignore");

    // CI (GitHub Actions): Postgres desechable, migrate y tests en cada push
    mkdir("$name/.github/workflows", 0755, true);
    copy("$source/.github/workflows/ci.yml", "$name/.github/workflows/ci.yml");
    copyTree("$source/docker", "$name/docker");

    $env = file_get_contents("$source/.env.example");
    $env = preg_replace('/^JWT_SECRET=.*$/m', 'JWT_SECRET=' . bin2hex(random_bytes(32)), $env);
    file_put_contents("$name/.env", $env);
    copy("$source/point", "$name/point");
    chmod("$name/point", 0755);

    // composer.json/lock de la plantilla (php ^8.4, autoload de listeners/, phpstan); el
    // Dockerfile copia ambos
    copy("$source/composer.json", "$name/composer.json");
    copy("$source/composer.lock", "$name/composer.lock");
    copy("$source/phpstan.neon", "$name/phpstan.neon");

    // Misma config que la plantilla: grupos public/protected/authenticated/admin/staff
    copy("$source/config/middleware.php", "$name/config/middleware.php");
    // Reglas de validación reutilizables (Rules::custom() se registra en bootstrap.php)
    copy("$source/services/Rules.php", "$name/services/Rules.php");
    // Referencia de endpoints (la plantilla de make:endpoint la enlaza)
    mkdir("$name/docs", 0755, true);
    copy("$source/docs/REFERENCIA_ENDPOINT.md", "$name/docs/REFERENCIA_ENDPOINT.md");

    $servicesConfig = <<<'PHP'
<?php

return [
    // Bindings explicitos: clase/interfaz => factory
    // Las clases en services/ se resuelven automaticamente via auto-wiring.
];
PHP;
    file_put_contents("$name/config/services.php", "$servicesConfig\n");

    $hello = <<<'PHP'
<?php

use Core\Endpoint;

Endpoint::from(__FILE__)
    ->at('GET /')
    ->name('root.hello')
    ->handle(fn() => [
        'status' => 200,
        'message' => 'Point framework is running!',
    ]);
PHP;
    file_put_contents("$name/endpoints/hello.php", "$hello\n");

    $gitignore = <<<'GI'
# Dependencias
vendor/

# Entorno (contiene secretos)
.env
.env.*
!.env.example

# make:http (puede contener un token pegado a mano)
requests.http

# Cache y storage
cache/
storage/jobs/
storage/logs/

# Framework
.point.json

# Seeds (datos de prueba)
database/seeds/

# OS
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo
GI;
    file_put_contents("$name/.gitignore", "$gitignore\n");

    echo "Proyecto '$name' creado (core minimalista, plugins: " . implode(', ', $basePlugins) . ").\n\n";
    echo "  cd $name\n";
    echo "  composer install\n";
    echo "  php point serve\n\n";
    echo "Plugins disponibles:\n";
    echo "  php point plugin:list          ver que hay\n";
    echo "  php point plugin:add ai        instalar uno\n";
}

