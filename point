/**
 * Quién puede llamar a una ruta según su grupo y sus middlewares 'through':
 * 'public', 'token' o 'roles: a,b'. Un grupo no declarado se marca (responde 500, parche 17).
 * @return array{protected: bool, label: string}
 */
function routeAccess(array $route): array
{
    $group = $route['group'] ?? null;
    if ($group && !\Core\Middleware\MiddlewareManager::hasGroup($group)) {
        return ['protected' => true, 'label' => "UNDEFINED GROUP '$group'"];
    }
    $middlewares = array_merge(
        $group ? \Core\Middleware\MiddlewareManager::getGroup($group) : [],
        $route['through'] ?? []
    );
    $roles = [];
    $auth = false;
    foreach ($middlewares as $m) {
        if (!is_string($m) || ($m !== 'auth' && !str_starts_with($m, 'auth:'))) {
            continue;
        }
        $auth = true;
        if (str_starts_with($m, 'auth:')) {
            $roles = array_merge($roles, array_map('trim', explode(',', substr($m, 5))));
        }
    }
    if (!$auth) {
        return ['protected' => false, 'label' => 'public'];
    }
    return ['protected' => true, 'label' => $roles ? 'roles: ' . implode(',', array_unique($roles)) : 'token'];
}

function listRoutes(): void
{
    requireProject();

    $routes = \Core\RouteRegistry::getInstance()->getRoutes();

    if (empty($routes)) {
        echo "No hay rutas registradas.\n";
        return;
    }

    usort($routes, fn($a, $b) => strcmp($a['path'], $b['path']));

    $rows = [];
    foreach ($routes as $route) {
        $methods = implode('|', $route['methods']);
        $path = $route['path'];
        $name = $route['name'] ?? '-';
        $group = $route['group'] ?? '-';

        $pipeline = '';
        if (!empty($route['connectsTo'])) {
            $targets = array_map(function ($c) {
                $name = is_array($c) ? $c['target'] : $c;
                $cond = (is_array($c) && !empty($c['when'])) ? '?' : '';
                return $cond . $name;
            }, $route['connectsTo']);
            $pipeline = implode(' -> ', $targets);
        }

        $flags = [];
        if (!empty($route['guards'])) $flags[] = 'guard';
        if (!empty($route['transform'])) $flags[] = 'transform';
        if (!empty($route['onError'])) $flags[] = 'onError';
        $flagStr = $flags ? '[' . implode(',', $flags) . ']' : '';

        $fields = implode(', ', array_keys($route['expects'] ?? [])) ?: '-';

        $rows[] = [$methods, $path, $name, $group, routeAccess($route)['label'], $fields, $pipeline, $flagStr];
    }

    $headers = ['METHOD', 'PATH', 'NAME', 'GROUP', 'ACCESS', 'FIELDS', 'PIPELINE', 'FLAGS'];
    $widths = array_fill(0, count($headers), 0);
    foreach ($rows as $row) {
        foreach ($row as $i => $col) {
            $widths[$i] = max($widths[$i], strlen($col));
        }
    }
    foreach ($headers as $i => $h) {
        $widths[$i] = max($widths[$i], strlen($h));
    }

    $line = '  ';
    foreach ($headers as $i => $h) {
        $line .= str_pad($h, $widths[$i] + 2);
    }
    echo "\n$line\n";
    echo '  ' . str_repeat('─', array_sum($widths) + count($widths) * 2) . "\n";

    foreach ($rows as $row) {
        $line = '  ';
        foreach ($row as $i => $col) {
            $line .= str_pad($col, $widths[$i] + 2);
        }
        echo "$line\n";
    }
    echo "\n";
}

