function runTests(?string $filter = null): void
{
    if (!file_exists('vendor/autoload.php')) {
        echo "Error: Ejecuta 'composer install' primero.\n";
        exit(1);
    }

    require_once 'vendor/autoload.php';
    require_once __DIR__ . '/core/Testing.php';

    $testsDir = getcwd() . '/tests';

    if (!is_dir($testsDir)) {
        echo "No existe el directorio tests/\n";
        exit(1);
    }

    // El servidor de test hereda esta variable y carga tests/fixtures/endpoints
    putenv('POINT_TESTING=1');
    // Contadores de rate limit aislados por ejecución (no arrastra intentos de corridas previas)
    putenv('RATE_LIMIT_DIR=' . sys_get_temp_dir() . '/point-ratelimit-' . getmypid());

    // Mismo entorno que el servidor de test (proceso primero, luego .env): así Auth::issue() en
    // un test firma con el JWT_SECRET que verifica el servidor. Sin uno válido, uno por corrida
    $dsnFromProcess = getenv('DB_DSN') !== false;
    foreach (getenv() as $key => $value) {
        $_ENV[$key] ??= $value;
    }
    // .env.testing (opcional, p. ej. DB_DSN de una base solo para tests) va antes que .env; lo que
    // carga se exporta para que el servidor de test y scribe lo hereden. El proceso sigue mandando
    $testingVars = [];
    if (file_exists(getcwd() . '/.env.testing')) {
        $testingVars = Dotenv\Dotenv::createImmutable(getcwd(), '.env.testing')->safeLoad();
        foreach ($testingVars as $key => $value) {
            putenv("$key=$value");
        }
    }
    Dotenv\Dotenv::createImmutable(getcwd())->safeLoad();
    if (file_exists(getcwd() . '/.env.' . ($_ENV['APP_ENV'] ?? 'development'))) {
        Dotenv\Dotenv::createImmutable(getcwd(), '.env.' . ($_ENV['APP_ENV'] ?? 'development'))->safeLoad();
    }
    if (strlen($_ENV['JWT_SECRET'] ?? '') < 32) {
        $_ENV['JWT_SECRET'] = bin2hex(random_bytes(32));
        putenv('JWT_SECRET=' . $_ENV['JWT_SECRET']);
    }

    // Con base propia de tests se migra antes de ejecutarlos (como en CI); sin ella, avisar
    if (isset($testingVars['DB_DSN'])) {
        passthru('php scribe migrate', $code);
        if ($code !== 0) {
            echo "Error: no se pudo migrar la base de tests (.env.testing).\n";
            exit(1);
        }
    } elseif (!$dsnFromProcess && ($_ENV['DB_DSN'] ?? '') !== '') {
        echo "Aviso: los tests usan la base de .env (desarrollo). Crea .env.testing con DB_DSN de una base solo para tests.\n";
    }

    $files = \Core\TestRunner::discover($testsDir);

    if (empty($files)) {
        echo "No se encontraron archivos *_test.php o *Test.php en tests/\n";
        exit(0);
    }

    $nameFilter = null;

    if ($filter) {
        $matchedFiles = array_filter($files, fn($f) => stripos($f, $filter) !== false);
        if (!empty($matchedFiles)) {
            $files = array_values($matchedFiles);
        } else {
            $nameFilter = $filter;
        }
    }

    echo "\n  Point Test Runner\n";

    $exitCode = \Core\TestRunner::loadAndRun($files, $nameFilter);
    echo "\n";
    exit($exitCode);
}

