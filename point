function createJob(?string $name): void
{
    if (!$name) {
        echo "Uso: php point make:job NombreJob\n";
        exit(1);
    }

    $className = ucfirst(preg_replace('/[^a-zA-Z0-9]/', '', $name));
    if (!str_ends_with($className, 'Job')) {
        $className .= 'Job';
    }
    $filename = "jobs/$className.php";

    if (!is_dir('jobs')) {
        mkdir('jobs', 0755, true);
    }

    if (file_exists($filename)) {
        echo "Ya existe: $filename\n";
        exit(1);
    }

    $content = <<<PHP
<?php
namespace App\Jobs;

class $className
{
    public function handle(array \$data): void
    {
        // Logica del job
    }

    public function failed(array \$data, \\Throwable \$e): void
    {
        error_log("$className fallo: " . \$e->getMessage());
    }
}
PHP;

    file_put_contents($filename, "$content\n");
    echo "Job creado: $filename\n";
    echo "Uso: dispatch(\\App\\Jobs\\$className::class, ['key' => 'value'])\n";
}

