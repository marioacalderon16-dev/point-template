function generateOpenApi(array $args = []): void
{
    requireProject();

    $routes = \Core\RouteRegistry::getInstance()->getRoutes();
    $paths = [];
    $usesAuth = false;

    foreach ($routes as $route) {
        $routeParams = [];
        preg_match_all('/\{([a-zA-Z0-9_]+)\}/', $route['path'], $matches);
        $pathParamNames = $matches[1];

        $isProtected = routeAccess($route)['protected'];
        if ($isProtected) {
            $usesAuth = true;
        }

        foreach ($route['methods'] as $method) {
            $isBodyMethod = in_array($method, ['POST', 'PUT', 'PATCH'], true);
            $parameters = [];
            $bodyProps = [];
            $bodyRequired = [];

            foreach ($route['expects'] ?? [] as $field => $ruleString) {
                $rules = is_array($ruleString) ? array_values($ruleString) : explode('|', $ruleString);
                $schema = rulesToSchema($rules);
                $required = in_array('required', $rules, true);

                $source = null;
                foreach ($rules as $r) {
                    if (str_starts_with($r, 'source:')) {
                        $source = explode(',', substr($r, 7))[0];
                        break;
                    }
                }

                if (in_array($field, $pathParamNames, true) || $source === 'route') {
                    $parameters[] = ['name' => $field, 'in' => 'path', 'required' => true, 'schema' => $schema];
                } elseif ($source === 'query' || !$isBodyMethod) {
                    $parameters[] = ['name' => $field, 'in' => 'query', 'required' => $required, 'schema' => $schema];
                } else {
                    $bodyProps[$field] = $schema;
                    if ($required) {
                        $bodyRequired[] = $field;
                    }
                }
            }

            // Parametros de ruta sin regla en expects
            $declared = array_column($parameters, 'name');
            foreach ($pathParamNames as $p) {
                if (!in_array($p, $declared, true)) {
                    $parameters[] = ['name' => $p, 'in' => 'path', 'required' => true, 'schema' => ['type' => 'string']];
                }
            }

            $responses = ['200' => ['description' => 'OK']];
            if (!empty($route['expects'])) {
                $responses['422'] = ['description' => 'Validation failed'];
            }
            if ($isProtected) {
                $responses['401'] = ['description' => 'No autenticado'];
                $responses['403'] = ['description' => 'Permisos insuficientes'];
            }

            $segments = array_filter(explode('/', trim($route['path'], '/')));
            $operation = [
                'operationId' => ($route['name'] ?? strtolower($method) . str_replace('/', '.', $route['path'])) . '.' . strtolower($method),
                'tags' => [reset($segments) ?: 'root'],
                'responses' => $responses,
            ];

            if ($parameters) {
                $operation['parameters'] = $parameters;
            }
            if ($bodyProps) {
                $bodySchema = ['type' => 'object', 'properties' => $bodyProps];
                if ($bodyRequired) {
                    $bodySchema['required'] = $bodyRequired;
                }
                $operation['requestBody'] = [
                    'required' => true,
                    'content' => ['application/json' => ['schema' => $bodySchema]],
                ];
            }
            if ($isProtected) {
                $operation['security'] = [['bearerAuth' => []]];
            }

            $paths[$route['path']][strtolower($method)] = $operation;
        }
    }

    $spec = [
        'openapi' => '3.0.3',
        'info' => ['title' => basename(getcwd()), 'version' => '1.0.0'],
        'paths' => $paths,
    ];
    if ($usesAuth) {
        $spec['components'] = [
            'securitySchemes' => [
                'bearerAuth' => ['type' => 'http', 'scheme' => 'bearer', 'bearerFormat' => 'JWT'],
            ],
        ];
    }

    file_put_contents('openapi.json', json_encode($spec, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n");
    printf("openapi.json generado (%d rutas)\n", count($paths));

    if (in_array('--serve', $args, true)) {
        $port = 8081;
        foreach ($args as $arg) {
            if (str_starts_with($arg, '--port=')) {
                $port = (int) substr($arg, 7);
            }
        }
        serveOpenApi($port);
    }
}

/** Swagger UI (via CDN) apuntando al openapi.json ya generado; nada que commitear. */
function serveOpenApi(int $port): void
{
    $dir = sys_get_temp_dir() . '/point_openapi_' . bin2hex(random_bytes(4));
    mkdir($dir, 0755, true);
    copy('openapi.json', "$dir/openapi.json");

    file_put_contents("$dir/index.html", <<<HTML
<!doctype html>
<html>
<head>
  <title>API docs</title>
  <link rel="stylesheet" href="https://unpkg.com/swagger-ui-dist@5/swagger-ui.css">
</head>
<body>
  <div id="swagger-ui"></div>
  <script src="https://unpkg.com/swagger-ui-dist@5/swagger-ui-bundle.js"></script>
  <script>
    window.onload = () => SwaggerUIBundle({ url: '/openapi.json', dom_id: '#swagger-ui' });
  </script>
</body>
</html>
HTML);

    echo "Sirviendo documentacion en http://localhost:$port (Ctrl+C para salir)\n\n";
    passthru('php -S localhost:' . $port . ' -t ' . escapeshellarg($dir));
}

function rulesToSchema(array $rules): array
{
    $schema = ['type' => 'string'];

    // Primera pasada: tipo
    foreach ($rules as $rule) {
        $name = explode(':', $rule, 2)[0];
        match ($name) {
            'integer' => $schema['type'] = 'integer',
            'numeric' => $schema['type'] = 'number',
            'boolean' => $schema['type'] = 'boolean',
            'array' => $schema['type'] = 'array',
            default => null,
        };
    }

    $isNumeric = in_array($schema['type'], ['integer', 'number'], true);

    foreach ($rules as $rule) {
        [$name, $param] = array_pad(explode(':', $rule, 2), 2, null);
        switch ($name) {
            case 'email': $schema['format'] = 'email'; break;
            case 'url': $schema['format'] = 'uri'; break;
            case 'uuid': $schema['format'] = 'uuid'; break;
            case 'date': $schema['format'] = 'date'; break;
            case 'ip': $schema['format'] = 'ip'; break;
            case 'in':
                $schema['enum'] = array_map('trim', explode(',', $param));
                break;
            case 'each':
                $schema['type'] = 'array';
                $schema['items'] = rulesToSchema([$param]);
                break;
            case 'min':
                $schema[$isNumeric ? 'minimum' : 'minLength'] = $isNumeric ? (float) $param : (int) $param;
                break;
            case 'max':
                $schema[$isNumeric ? 'maximum' : 'maxLength'] = $isNumeric ? (float) $param : (int) $param;
                break;
            case 'between':
                $limits = array_map('trim', explode(',', $param));
                if (count($limits) === 2) {
                    $schema[$isNumeric ? 'minimum' : 'minLength'] = $isNumeric ? (float) $limits[0] : (int) $limits[0];
                    $schema[$isNumeric ? 'maximum' : 'maxLength'] = $isNumeric ? (float) $limits[1] : (int) $limits[1];
                }
                break;
            case 'default':
                $schema['default'] = $param;
                break;
        }
    }

    if ($schema['type'] === 'array' && !isset($schema['items'])) {
        $schema['items'] = ['type' => 'string'];
    }

    return $schema;
}

// ────────────────────────────────────────────────
// MAKE:ENDPOINT
// ────────────────────────────────────────────────

function createEndpoint(array $args): void
{
    if (empty($args)) {
        echo "Uso: php point make:endpoint <ruta> [--post|--put|--patch|--delete] [--group=nombre] [--public]\n";
        echo "Ejemplo: php point make:endpoint users/create --post --group=admin_area\n";
        exit(1);
    }

    $userPath = $args[0];
    $httpMethod = 'GET';
    $group = 'protected';

    $methodMap = [
        '--get' => 'GET', '--post' => 'POST', '--put' => 'PUT',
        '--patch' => 'PATCH', '--delete' => 'DELETE',
    ];

    for ($i = 1; $i < count($args); $i++) {
        $arg = $args[$i];

        if (str_starts_with($arg, '--method=')) {
            $method = strtoupper(substr($arg, 9));
            if (!in_array($method, ['GET', 'POST', 'PUT', 'PATCH', 'DELETE'], true)) {
                echo "Metodo HTTP invalido: $method\n";
                exit(1);
            }
            $httpMethod = $method;
        } elseif (str_starts_with($arg, '--group=')) {
            $group = substr($arg, 8);
        } elseif ($arg === '--public') {
            $group = 'public';
        } elseif (isset($methodMap[$arg])) {
            $httpMethod = $methodMap[$arg];
        } else {
            echo "Opcion desconocida: $arg\n";
            exit(1);
        }
    }

    $internalPath = preg_replace('/\:([a-zA-Z_][a-zA-Z0-9_]*)/', '{$1}', $userPath);

    $segments = array_values(array_filter(explode('/', trim($userPath, '/'))));
    if (empty($segments)) {
        echo "Ruta invalida.\n";
        exit(1);
    }

    $lastSegment = end($segments);
    $lastIsParam = preg_match('/^:/', $lastSegment);

    if ($lastIsParam) {
        $filenameBase = count($segments) >= 2 ? $segments[count($segments) - 2] : 'item';
        $dirSegments = array_slice($segments, 0, max(0, count($segments) - 2));
        $endpointSegments = array_slice($segments, 0, -1);
    } else {
        $filenameBase = $lastSegment;
        $dirSegments = array_slice($segments, 0, -1);
        $endpointSegments = $segments;
    }

    $dir = implode(DIRECTORY_SEPARATOR, $dirSegments);
    $fullDir = 'endpoints' . ($dir ? DIRECTORY_SEPARATOR . $dir : '');
    $fullPath = "$fullDir/$filenameBase.php";

    if (!is_dir($fullDir)) {
        mkdir($fullDir, 0755, true);
    }

    if (file_exists($fullPath)) {
        echo "El endpoint ya existe: $fullPath\n";
        exit(1);
    }

    $endpointName = implode('.', $endpointSegments);
    $routePath = '/' . trim($internalPath, '/');

    $content = <<<PHP
