/** Valor de ejemplo para un campo según sus reglas (requests.http). */
function sampleValue(string $field, array $rules): mixed
{
    $schema = rulesToSchema($rules);
    if (!empty($schema['enum'])) {
        return $schema['enum'][0];
    }
    return match ($schema['format'] ?? $schema['type']) {
        'email' => 'ana@example.com',
        'uuid' => '00000000-0000-4000-8000-000000000000',
        'date' => date('Y-m-d'),
        'uri' => 'https://example.com',
        'integer' => 1,
        'number' => 1.5,
        'boolean' => true,
        'array' => [],
        default => $field,
    };
}

/**
 * Petición de ejemplo para una ruta: parámetros de ruta a 1 y campos de expects con valores de
 * ejemplo según sus reglas (sin archivos). La usan make:http y test --smoke.
 * @return array{path: string, fields: array, hasBody: bool}
 */
function sampleRequest(array $route, string $method): array
{
    preg_match_all('/\{([a-zA-Z0-9_]+)(?::[a-zA-Z]+)?\}/', $route['path'], $m);
    $fields = [];
    foreach ($route['expects'] ?? [] as $field => $ruleString) {
        if (in_array($field, $m[1], true)) {
            continue;
        }
        $rules = is_array($ruleString) ? array_values($ruleString) : explode('|', $ruleString);
        if (in_array('file', $rules, true)) {
            continue; // los archivos no se pueden enviar en JSON
        }
        $fields[$field] = sampleValue($field, $rules);
    }
    return [
        'path' => (string) preg_replace('/\{([a-zA-Z0-9_]+)(?::[a-zA-Z]+)?\}/', '1', $route['path']),
        'fields' => $fields,
        'hasBody' => in_array($method, ['POST', 'PUT', 'PATCH'], true),
    ];
}

function makeHttp(array $args): void
{
    requireProject();

    $file = 'requests.http';
    foreach ($args as $arg) {
        if (str_starts_with($arg, '--output=')) {
            $file = substr($arg, 9);
        }
    }
    if (file_exists($file) && !in_array('--force', $args, true)) {
        echo "Ya existe $file (usa --force para regenerarlo; se perderán los cambios a mano).\n";
        exit(1);
    }

    $routes = \Core\RouteRegistry::getInstance()->getRoutes();
    usort($routes, fn ($a, $b) => strcmp($a['path'], $b['path']));

    $port = $_ENV['APP_PORT'] ?? '8080';
    $out = "# Generado con `php point make:http`. Ábrelo con REST Client (VS Code) o el cliente HTTP de PhpStorm.\n"
        . "# Pega un token en @token (por ejemplo, la respuesta de tu endpoint de login).\n"
        . "# Está en .gitignore: no lo subas al repositorio si contiene un token real.\n\n"
        . "@baseUrl = http://localhost:$port\n@token = PEGA_AQUI_UN_TOKEN\n";

    foreach ($routes as $route) {
        $access = routeAccess($route);

        foreach ($route['methods'] as $method) {
            ['path' => $path, 'fields' => $fields, 'hasBody' => $hasBody] = sampleRequest($route, $method);
            if (!$hasBody && $fields) {
                $path .= '?' . http_build_query(array_map(fn ($v) => is_bool($v) ? ($v ? 'true' : 'false') : $v, $fields));
            }

            $title = ($route['name'] ?? null) ? "{$route['name']} · {$access['label']}" : $access['label'];
            $out .= "\n### $method {$route['path']} ($title)\n$method {{baseUrl}}$path\n";
            if ($access['protected']) {
                $out .= "Authorization: Bearer {{token}}\n";
            }
            if ($hasBody) {
                $out .= "Content-Type: application/json\n\n"
                    . json_encode((object) $fields, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE) . "\n";
            }
        }
    }

    file_put_contents($file, $out);
    printf("%s generado (%d rutas)\n", $file, count($routes));
}

