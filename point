/** Carga la app (.env, DB, helpers, plugins) sin registrar rutas. */
function requireApp(): void
{
    if (!file_exists('vendor/autoload.php')) {
        echo "Error: Ejecuta 'composer install' primero.\n";
        exit(1);
    }
    if (!defined('POINT_NO_ROUTES')) define('POINT_NO_ROUTES', true);
    require_once 'vendor/autoload.php';
    require_once 'bootstrap.php';
}

/** Valor de una opción --nombre=valor, o null. */
function cliOption(array $argv, string $name): ?string
{
    foreach ($argv as $arg) {
        if (str_starts_with($arg, "--{$name}=")) return substr($arg, strlen($name) + 3);
    }
    return null;
}

function work(array $argv): void
{
    requireApp();

    $once = in_array('--once', $argv);
    $maxJobs = (int) (cliOption($argv, 'max-jobs') ?? 0);
    $maxTime = (int) (cliOption($argv, 'max-time') ?? 0);
    $start = time();

    // SIGTERM/SIGINT: terminar el job actual y salir
    $stop = false;
    if (function_exists('pcntl_async_signals')) {
        pcntl_async_signals(true);
        $handler = function () use (&$stop) { $stop = true; };
        pcntl_signal(SIGTERM, $handler);
        pcntl_signal(SIGINT, $handler);
    }

    echo "Point worker " . ($once ? "(once)" : "started") . "\n";

    $processed = 0;
    $result = null;

    do {
        if ($stop) { echo "  Señal recibida, saliendo.\n"; break; }
        if ($maxJobs > 0 && $processed >= $maxJobs) { echo "  Alcanzado --max-jobs={$maxJobs}.\n"; break; }
        if ($maxTime > 0 && time() - $start >= $maxTime) { echo "  Alcanzado --max-time={$maxTime}s.\n"; break; }

        $result = \Core\Queue::processNext();

        if ($result) {
            $processed++;
            $icon = match ($result['status']) {
                'ok' => "\033[32mOK\033[0m",
                'retry' => "\033[33mRETRY\033[0m",
                'failed' => "\033[31mFAILED\033[0m",
            };
            $name = basename(str_replace('\\', '/', $result['job']));
            echo "  [$icon] $name";
            if (isset($result['error'])) echo " - {$result['error']}";
            if (isset($result['attempt'])) echo " (intento {$result['attempt']})";
            echo "\n";

            if ($once) break;
        } elseif (!$once) {
            $wait = $maxTime > 0 ? max(0, min(3, $maxTime - (time() - $start))) : 3;
            if ($wait > 0) sleep($wait);
        }
    } while (!$once);

    if ($once && !$result) {
        echo "  No hay jobs pendientes.\n";
    }
}

function workFailed(): void
{
    requireApp();

    $failed = \Core\Queue::failed();

    if (empty($failed)) {
        echo "No hay jobs fallidos.\n";
        return;
    }

    echo sprintf("  %-20s %-40s %-20s %s\n", 'ID', 'JOB', 'FAILED AT', 'ERROR');
    echo "  " . str_repeat('-', 100) . "\n";

    foreach ($failed as $job) {
        $name = basename(str_replace('\\', '/', $job['job']));
        $id = substr($job['id'] ?? '', 0, 18);
        echo sprintf("  %-20s %-40s %-20s %s\n",
            $id,
            $name,
            $job['failed_at'] ?? '-',
            substr($job['last_error'] ?? '-', 0, 40)
        );
    }

    echo "\n  " . count($failed) . " job(s) fallido(s). Usa 'php point work:retry' para reintentar.\n";
}

function workRetry(): void
{
    requireApp();

    $count = \Core\Queue::retry();
    echo $count > 0
        ? "$count job(s) movido(s) de vuelta a la cola.\n"
        : "No hay jobs fallidos para reintentar.\n";
}

function workFlush(): void
{
    requireApp();

    $count = \Core\Queue::flush();
    echo $count > 0
        ? "$count job(s) fallido(s) eliminados.\n"
        : "No hay jobs fallidos.\n";
}

// ────────────────────────────────────────────────
// DB:SQL (SQL crudo versionado en database/sql)
// ────────────────────────────────────────────────

function dbSql(array $args): void
{
    requireApp();

    $force = in_array('--force', $args, true);
    $files = in_array('--all', $args, true)
        ? (glob('database/sql/*.sql') ?: [])
        : array_values(array_filter($args, fn($a) => !str_starts_with($a, '--')));

    if (empty($files)) {
        echo "Uso: php point db:sql <archivo.sql> [--force] | --all\n";
        exit(1);
    }
    sort($files);

    $pdo = \Core\DB::connection();
    // Postgres con options='--search_path=esquema': en una base nueva el esquema aún no existe
    // y _sql_migrations no tendría dónde crearse
    if ($pdo->getAttribute(PDO::ATTR_DRIVER_NAME) === 'pgsql') {
        $schema = trim(explode(',', (string) $pdo->query('SHOW search_path')->fetchColumn())[0], ' "');
        if ($schema !== '' && !str_starts_with($schema, '$')) {
            $pdo->exec('CREATE SCHEMA IF NOT EXISTS "' . str_replace('"', '""', $schema) . '"');
        }
    }
    $pdo->exec('CREATE TABLE IF NOT EXISTS _sql_migrations (file text PRIMARY KEY, applied_at timestamptz DEFAULT CURRENT_TIMESTAMP)');
    $applied = $pdo->query('SELECT file FROM _sql_migrations')->fetchAll(PDO::FETCH_COLUMN);

    $count = 0;
    foreach ($files as $path) {
        if (!is_file($path)) {
            echo "  \033[31mNo existe:\033[0m $path\n";
            exit(1);
        }
        $name = basename($path);
        if (!$force && in_array($name, $applied, true)) {
            echo "  [SKIP] $name (ya aplicado)\n";
            continue;
        }

        // Archivo completo en una transacción; rollback si falla
        $pdo->beginTransaction();
        try {
            $pdo->exec(file_get_contents($path));
            $pdo->prepare('DELETE FROM _sql_migrations WHERE file = ?')->execute([$name]);
            $pdo->prepare('INSERT INTO _sql_migrations (file) VALUES (?)')->execute([$name]);
            $pdo->commit();
            echo "  [\033[32mOK\033[0m] $name\n";
            $count++;
        } catch (\Throwable $e) {
            if ($pdo->inTransaction()) $pdo->rollBack();
            echo "  [\033[31mERROR\033[0m] $name - {$e->getMessage()}\n";
            exit(1);
        }
    }

    echo "  $count archivo(s) aplicado(s).\n";
}

