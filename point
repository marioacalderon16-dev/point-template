#!/usr/bin/env php
<?php

$argv = $_SERVER['argv'] ?? [];
$command = $argv[1] ?? null;

match ($command) {
    'init' => init($argv[2] ?? null),
    'serve' => serve($argv[2] ?? '8080'),
    'routes' => listRoutes(),
    'cache' => cacheRoutes(),
    'cache:clear' => clearRouteCache(),
    'openapi' => generateOpenApi(array_slice($argv, 2)),
    'test' => runTests($argv[2] ?? null),
    'work' => work($argv),
    'work:failed' => workFailed(),
    'work:retry' => workRetry(),
    'work:flush' => workFlush(),
    'db:sql' => dbSql(array_slice($argv, 2)),
    'make:endpoint' => createEndpoint(array_slice($argv, 2)),
    'make:middleware' => createMiddleware($argv[2] ?? null),
    'make:service' => createService($argv[2] ?? null),
    'make:job' => createJob($argv[2] ?? null),
    'make:listener' => createListener($argv[2] ?? null),
    'make:test' => createTest($argv[2] ?? null),
    'make:migration' => delegateScribe('make:migration', array_slice($argv, 2)),
    'make:seed' => delegateScribe('make:seed', array_slice($argv, 2)),
    'migrate' => delegateScribe('migrate', []),
    'rollback' => delegateScribe('rollback', []),
    'seed' => delegateScribe('seed', []),
    'make:plugin' => createPlugin($argv[2] ?? null),
    'plugin:list' => listPlugins(),
    'plugin:add' => addPlugin($argv[2] ?? null),
    'plugin:remove' => removePlugin(array_slice($argv, 2)),
    default => help(),
};

function requireProject(): void
{
    if (!file_exists('vendor/autoload.php')) {
        echo "Error: Ejecuta 'composer install' primero.\n";
        exit(1);
    }
    define('POINT_NO_MANIFEST', true);
    require_once 'vendor/autoload.php';
    require_once 'bootstrap.php';
}

function copyTree(string $from, string $to): void
{
    if (!is_dir($to)) {
        mkdir($to, 0755, true);
    }

    foreach (scandir($from) ?: [] as $entry) {
        if ($entry === '.' || $entry === '..' || str_starts_with($entry, '.')) {
            continue;
        }
        $src = "$from/$entry";
        $dst = "$to/$entry";
        is_dir($src) ? copyTree($src, $dst) : copy($src, $dst);
    }
}

