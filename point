function cacheRoutes(): void
{
    requireProject();

    // buildManifest usa los endpointDirs fijados por bootstrap (proyecto + plugins)
    $manifest = \Core\RouteRegistry::getInstance()->buildManifest(getcwd());

    if (!is_dir('cache')) {
        mkdir('cache', 0755);
    }
    file_put_contents('cache/routes.php', '<?php return ' . var_export($manifest, true) . ';');

    printf("%d rutas cacheadas en cache/routes.php (carga lazy activada)\n", count($manifest['routes']));
}

function clearRouteCache(): void
{
    if (file_exists('cache/routes.php')) {
        unlink('cache/routes.php');
        echo "Cache eliminado (carga completa activada).\n";
    } else {
        echo "No hay cache que eliminar.\n";
    }
}

